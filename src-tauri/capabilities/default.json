{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Masaüstü ana pencere izinleri. Mobil için ayrı dosya: mobile.json (orada $HOME yok). Kindle (LOM-84): dış disklerde yalnız disk adları listelenir ve yalnız documents/My Clippings.txt okunur; yazma izni yok.",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default",
    "deep-link:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$APPDATA/**" },
        { "path": "/Volumes/*/documents/My Clippings.txt" },
        { "path": "/media/*/documents/My Clippings.txt" },
        { "path": "/media/*/*/documents/My Clippings.txt" },
        { "path": "/run/media/*/*/documents/My Clippings.txt" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.trash" },
        { "path": "$HOME/**/.trash/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" },
        { "path": "/Volumes" },
        { "path": "/media" },
        { "path": "/media/*" },
        { "path": "/run/media" },
        { "path": "/run/media/*" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.trash" },
        { "path": "$HOME/**/.trash/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" },
        { "path": "/Volumes/*/documents/My Clippings.txt" },
        { "path": "/media/*/documents/My Clippings.txt" },
        { "path": "/media/*/*/documents/My Clippings.txt" },
        { "path": "/run/media/*/*/documents/My Clippings.txt" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.trash" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.trash" },
        { "path": "$HOME/**/.trash/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.trash" },
        { "path": "$HOME/**/.trash/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" }
      ]
    }
  ]
}
