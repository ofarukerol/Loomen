{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "iPhone/Android ana pencere izinleri. Masaüstünden farkı: kasa yalnız uygulamanın kendi veri klasöründedir ($APPDATA), bu yüzden $HOME/** erişimi VERİLMEZ.",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "deep-link:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPDATA/**/.trash" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/**/.trash" },
        { "path": "$APPDATA/**/.trash/**" }
      ]
    }
  ]
}
