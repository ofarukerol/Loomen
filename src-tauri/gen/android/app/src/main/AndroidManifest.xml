<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ses notu kaydi (src/screens/Editor/VoiceRecorder.tsx — WebView getUserMedia).
         Bu izin manifest'te yoksa Android'de mikrofon HIC acilamaz. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- allowBackup=false: GitHub oturum bilgisi ve AI anahtarlari uygulama
         verisinde duz dosyada duruyor (src-tauri/src/ai/keys.rs). Acik birakilirsa
         Google bulut yedegine ve cihaz-cihaz aktarimina kopyalanirlar. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.loomen"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google Takvim girisi (ters-client-id ozel semasi). Mobil OAuth yonlendirmesi
                 com.googleusercontent.apps.<ID>:/oauth2redirect adresine donuyor
                 (src/core/google.ts:33-35); bu intent-filter olmadan Android yonlendirmeyi
                 uygulamaya teslim edemez, giris sessizce basarisiz olur.
                 YER TUTUCU — INSAN ISI: Google Console'da "Android" tipi OAuth client
                 (paket: org.loomen.notes + release imzasinin SHA-1) olusturunca asagidaki
                 scheme'i o client'in ters id'siyle GUNCELLE:
                 com.googleusercontent.apps.<ANDROID_CLIENT_ID_SAYISAL_KISMI>
                 Ayni id .env icindeki VITE_GOOGLE_ANDROID_CLIENT_ID ile birebir uyusmali.
                 Bu blok elle yazildi; asagidaki "DEEP LINK PLUGIN" blogunu tauri.conf.json'dan
                 eklenti uretir, oraya elle yazma. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.GOOGLE_ANDROID_CLIENT" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
