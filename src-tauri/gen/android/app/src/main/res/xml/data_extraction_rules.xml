<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 ve sonrasi icin yedekleme kurallari.

  NEDEN: AndroidManifest'teki android:allowBackup="false" yalnizca BULUT yedegini
  kapatir; Android 12+ cihaz-cihaz aktarimi (device-to-device) ayri bir yoldur ve
  bu dosya olmadan uygulama verisini yine de kopyalar. Loomen'in uygulama verisinde
  GitHub oturum jetonu ve AI saglayici anahtarlari duz dosyada duruyor
  (src-tauri/src/ai/keys.rs), bu yuzden iki yol da kapatiliyor.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
